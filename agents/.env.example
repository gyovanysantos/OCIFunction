# ──────────────────────────────────────────────────────────────
# JDE Integrity Analyzer — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# In OCI deployment, set these as container environment variables.

# OCI ADK auth type (required)
# api_key   — local dev (reads ~/.oci/config)
# instance_principal — OCI compute instances
# resource_principal — OCI Functions
OCI_AUTH_TYPE=api_key
OCI_REGION=us-phoenix-1
OCI_PROFILE=DEFAULT

# Agent endpoint OCIDs (required)
# Create agents in OCI Console → Analytics & AI → Generative AI Agents → jdee1 compartment
# Copy the endpoint OCID (not the agent OCID) for each agent.
EXTRACTOR_AGENT_ENDPOINT_ID=ocid1.genaiagentendpoint.oc1.phx.your-extractor-endpoint
ANALYZER_AGENT_ENDPOINT_ID=ocid1.genaiagentendpoint.oc1.phx.your-analyzer-endpoint

# JDE MCP Server URL (required for AnalyzerAgent MCP bridge)
# Local dev: http://localhost:3000/mcp
# Docker:    http://mcp:3000/mcp
MCP_SERVER_URL=http://localhost:3000/mcp

# OCI Object Storage (for PDF downloads)
OCI_BUCKET_NAME=OBJECTSTORAGE
OCI_NAMESPACE=idxoqn0ijjyv
