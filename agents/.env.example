# ──────────────────────────────────────────────────────────────
# JDE Integrity Analyzer — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# In Foundry deployment, these are set by the platform automatically.

# Azure AI Foundry project endpoint (required)
# Find this in: Azure Portal → AI Foundry → Your Project → Overview
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project-id

# Model deployment name (required)
# The name of your deployed model in the Foundry project (e.g. gpt-4o, gpt-4o-mini)
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1

# JDE MCP Server URL (required for AnalyzerAgent)
# Local dev: http://localhost:3000/mcp
# Production: Your Azure Container Apps URL
MCP_SERVER_URL=http://localhost:3000/mcp

# OCI Object Storage (for PDF downloads)
# These default to the project's existing bucket configuration
OCI_BUCKET_NAME=agent-knowledge-base
OCI_NAMESPACE=axzkbtajofjq
