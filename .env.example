# ──────────────────────────────────────────────────────────────
# docker-compose environment variables
# ──────────────────────────────────────────────────────────────
# Copy to .env and fill in your values.
# docker compose reads this file automatically.

# ── JDE AIS (for MCP server) ──────────────────────────────────
JDE_AIS_URL=https://your-ais-server:port/jderest
JDE_USERNAME=your_jde_user
JDE_PASSWORD=your_jde_password
JDE_ENVIRONMENT=JDV920
JDE_ROLE=*ALL

# ── Azure AI Foundry (for agents) ─────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project-id
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1

# ── OCI Object Storage (for ExtractorAgent) ────────────────────
OCI_BUCKET_NAME=OBJECTSTORAGE
OCI_NAMESPACE=idxoqn0ijjyv
