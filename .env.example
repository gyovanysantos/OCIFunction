# ──────────────────────────────────────────────────────────────
# docker-compose environment variables
# ──────────────────────────────────────────────────────────────
# Copy to .env and fill in your values.
# docker compose reads this file automatically.

# ── JDE AIS (for MCP server) ──────────────────────────────────
JDE_AIS_URL=https://your-ais-server:port/jderest
JDE_USERNAME=your_jde_user
JDE_PASSWORD=your_jde_password
JDE_ENVIRONMENT=JDV920
JDE_ROLE=*ALL

# ── OCI ADK (for agents) ──────────────────────────────────────
# Auth type: api_key (local dev), instance_principal (OCI compute), resource_principal (OCI Functions)
OCI_AUTH_TYPE=api_key
OCI_REGION=us-phoenix-1
OCI_PROFILE=DEFAULT

# Agent endpoint OCIDs (from OCI Console → Analytics & AI → Generative AI Agents)
EXTRACTOR_AGENT_ENDPOINT_ID=ocid1.genaiagentendpoint.oc1.phx.your-extractor-endpoint
ANALYZER_AGENT_ENDPOINT_ID=ocid1.genaiagentendpoint.oc1.phx.your-analyzer-endpoint

# ── OCI Object Storage (for ExtractorAgent) ────────────────────
OCI_BUCKET_NAME=OBJECTSTORAGE
OCI_NAMESPACE=idxoqn0ijjyv

# ── ADK Debug (optional) ──────────────────────────────────────
# Set to DEBUG for tool execution traces and OPC request IDs
# ADK_LOG_LEVEL=DEBUG
