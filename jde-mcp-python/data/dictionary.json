{
  "version": "1.3.0",
  "lastUpdated": "2026-04-12",
  "scope": "Sales Orders (full CRUD) + Accounts Payable / General Ledger Integrity (R047001A) + Unposted Batches (R007011)",
  "tables": [
    {
      "tableName": "F4211",
      "displayName": "Sales Order Detail",
      "description": "One row per sales order detail line. Stores item, quantity, pricing, status, and scheduling for each line on a sales order.",
      "functionalArea": "Sales Orders",
      "columns": [
        { "alias": "DOCO",  "name": "Order Number",         "description": "Sales order document number",                  "dataType": "number", "example": "12345" },
        { "alias": "DCTO",  "name": "Order Type",           "description": "Document type (SO=Sales Order, ST=Transfer)",  "dataType": "string", "example": "SO" },
        { "alias": "KCOO",  "name": "Order Company",        "description": "Company that owns the order",                  "dataType": "string", "example": "00001" },
        { "alias": "LNID",  "name": "Line Number",          "description": "Line number (x1000, e.g. 1000 = line 1)",      "dataType": "number", "example": "1000" },
        { "alias": "AN8",   "name": "Customer Number",      "description": "Address book number of the sold-to customer",  "dataType": "number", "example": "4242" },
        { "alias": "SHAN",  "name": "Ship To Number",       "description": "Address book number of ship-to address",       "dataType": "number", "example": "4242" },
        { "alias": "LITM",  "name": "Item Number",          "description": "2nd item number (user-facing item ID)",        "dataType": "string", "example": "ABC123" },
        { "alias": "ITM",   "name": "Short Item Number",    "description": "System-generated short item number",           "dataType": "number", "example": "50001" },
        { "alias": "DSC1",  "name": "Item Description",     "description": "First line of item description",               "dataType": "string", "example": "Widget A" },
        { "alias": "UORG",  "name": "Quantity Ordered",     "description": "Original quantity ordered (units)",             "dataType": "number", "example": "100" },
        { "alias": "SOQS",  "name": "Quantity Shipped",     "description": "Quantity shipped so far",                       "dataType": "number", "example": "50" },
        { "alias": "SOBK",  "name": "Quantity Backordered", "description": "Quantity on backorder",                         "dataType": "number", "example": "50" },
        { "alias": "UPRC",  "name": "Unit Price",           "description": "Unit price in domestic currency",               "dataType": "number", "example": "25.50" },
        { "alias": "AEXP",  "name": "Extended Amount",      "description": "Extended price (qty × unit price)",             "dataType": "number", "example": "2550.00" },
        { "alias": "LNTY",  "name": "Line Type",            "description": "Line type code (S=Stock, B=Bulk, N=Non-Stock)", "dataType": "string", "example": "S" },
        { "alias": "NXTR",  "name": "Next Status",          "description": "Next processing status code",                  "dataType": "string", "example": "560" },
        { "alias": "LTTR",  "name": "Last Status",          "description": "Last processing status completed",             "dataType": "string", "example": "540" },
        { "alias": "MCU",   "name": "Branch/Plant",         "description": "Business unit / branch-plant",                 "dataType": "string", "example": "M30" },
        { "alias": "DRQJ",  "name": "Requested Date",       "description": "Customer requested delivery date (Julian)",    "dataType": "date",   "example": "2026-04-10" },
        { "alias": "PDDJ",  "name": "Promised Date",        "description": "Promised delivery date (Julian)",              "dataType": "date",   "example": "2026-04-12" },
        { "alias": "TRDJ",  "name": "Order Date",           "description": "Date the order was entered (Julian)",          "dataType": "date",   "example": "2026-04-01" }
      ]
    },
    {
      "tableName": "F4201",
      "displayName": "Sales Order Header",
      "description": "One row per sales order header. Order-level info: customer, dates, totals, hold codes, status.",
      "functionalArea": "Sales Orders",
      "columns": [
        { "alias": "DOCO",  "name": "Order Number",       "description": "Sales order document number",                  "dataType": "number", "example": "12345" },
        { "alias": "DCTO",  "name": "Order Type",         "description": "Document type",                                "dataType": "string", "example": "SO" },
        { "alias": "KCOO",  "name": "Order Company",      "description": "Company that owns the order",                  "dataType": "string", "example": "00001" },
        { "alias": "AN8",   "name": "Customer Number",    "description": "Sold-to customer address book number",         "dataType": "number", "example": "4242" },
        { "alias": "SHAN",  "name": "Ship To Number",     "description": "Ship-to address book number",                  "dataType": "number", "example": "4242" },
        { "alias": "MCU",   "name": "Branch/Plant",       "description": "Default branch/plant for the order",           "dataType": "string", "example": "M30" },
        { "alias": "TRDJ",  "name": "Order Date",         "description": "Date the order was entered",                   "dataType": "date",   "example": "2026-04-01" },
        { "alias": "DRQJ",  "name": "Requested Date",     "description": "Customer requested delivery date",             "dataType": "date",   "example": "2026-04-10" },
        { "alias": "PDDJ",  "name": "Promised Date",      "description": "Promised delivery date",                       "dataType": "date",   "example": "2026-04-12" },
        { "alias": "OTOT",  "name": "Order Total",        "description": "Total domestic amount on the order",           "dataType": "number", "example": "15000.00" },
        { "alias": "HOLD",  "name": "Hold Code",          "description": "Order hold code (blank = no hold)",            "dataType": "string", "example": "" },
        { "alias": "NXTR",  "name": "Next Status",        "description": "Next processing status for the header",        "dataType": "string", "example": "560" },
        { "alias": "VR01",  "name": "Reference 1",        "description": "Customer PO or reference number",              "dataType": "string", "example": "PO-2026-001" }
      ]
    },
    {
      "tableName": "F0101",
      "displayName": "Address Book Master",
      "description": "Master address book. Used to validate and look up customer numbers when creating/querying sales orders.",
      "functionalArea": "Address Book",
      "columns": [
        { "alias": "AN8",   "name": "Address Number",     "description": "Unique address book number",                   "dataType": "number", "example": "4242" },
        { "alias": "ALPH",  "name": "Alpha Name",         "description": "Entity name (person or company)",              "dataType": "string", "example": "Acme Corp" },
        { "alias": "DC",    "name": "Description Comp",   "description": "Compressed search name",                      "dataType": "string", "example": "ACMECORP" },
        { "alias": "AT1",   "name": "Search Type",        "description": "C=Customer, V=Supplier, E=Employee",          "dataType": "string", "example": "C" },
        { "alias": "ADD1",  "name": "Address Line 1",     "description": "Primary address line",                         "dataType": "string", "example": "123 Main St" },
        { "alias": "CTY1",  "name": "City",               "description": "City name",                                   "dataType": "string", "example": "São Paulo" },
        { "alias": "ADDS",  "name": "State",              "description": "State or province code",                       "dataType": "string", "example": "SP" },
        { "alias": "CTR",   "name": "Country",            "description": "Country code",                                "dataType": "string", "example": "BR" }
      ]
    },
    {
      "tableName": "F4101",
      "displayName": "Item Master",
      "description": "Master item table. Used to validate item numbers when adding lines to sales orders.",
      "functionalArea": "Inventory",
      "columns": [
        { "alias": "ITM",   "name": "Short Item Number",  "description": "System short item number",                    "dataType": "number", "example": "50001" },
        { "alias": "LITM",  "name": "2nd Item Number",    "description": "User-facing item number",                     "dataType": "string", "example": "ABC123" },
        { "alias": "DSC1",  "name": "Description",        "description": "Primary item description",                    "dataType": "string", "example": "Widget Type A" },
        { "alias": "STKT",  "name": "Stocking Type",      "description": "M=Manufactured, P=Purchased",                "dataType": "string", "example": "P" },
        { "alias": "UOM1",  "name": "Primary UOM",        "description": "Primary unit of measure",                     "dataType": "string", "example": "EA" }
      ]
    },
    {
      "tableName": "F41021",
      "displayName": "Item Branch",
      "description": "Item at branch/plant level. Used to check availability before adding items to a sales order.",
      "functionalArea": "Inventory",
      "columns": [
        { "alias": "ITM",   "name": "Short Item Number",  "description": "System short item number",                    "dataType": "number", "example": "50001" },
        { "alias": "LITM",  "name": "2nd Item Number",    "description": "User-facing item number",                     "dataType": "string", "example": "ABC123" },
        { "alias": "MCU",   "name": "Branch/Plant",       "description": "Business unit / branch-plant",                "dataType": "string", "example": "M30" },
        { "alias": "OPC",   "name": "On Hand Quantity",   "description": "Primary quantity on hand",                    "dataType": "number", "example": "250" }
      ]
    },
    {
      "tableName": "F0411",
      "displayName": "A/P Ledger",
      "description": "Accounts Payable voucher table. One row per voucher pay item. Stores supplier invoices, amounts, GL posting codes, payment status. Core table for R047001A (A/P to G/L Integrity by Offset Account).",
      "functionalArea": "Accounts Payable",
      "columns": [
        { "alias": "DOC",   "name": "Document Number",      "description": "Voucher document number",                            "dataType": "number", "example": "12345" },
        { "alias": "DCT",   "name": "Document Type",        "description": "Document type (PV=Voucher, PM=Manual, P1=Logged)",   "dataType": "string", "example": "PV" },
        { "alias": "KCO",   "name": "Document Company",     "description": "Company that owns the voucher",                      "dataType": "string", "example": "00001" },
        { "alias": "SFX",   "name": "Pay Item Suffix",      "description": "Pay item suffix (001, 002, etc.)",                   "dataType": "string", "example": "001" },
        { "alias": "CO",    "name": "Company",              "description": "Company code",                                       "dataType": "string", "example": "00001" },
        { "alias": "AN8",   "name": "Supplier Number",      "description": "Address book number of the supplier",                "dataType": "number", "example": "6001" },
        { "alias": "MCU",   "name": "Business Unit",        "description": "Business unit / cost center",                        "dataType": "string", "example": "1" },
        { "alias": "AG",    "name": "Gross Amount",         "description": "Gross amount of the voucher pay item",               "dataType": "number", "example": "15000.00" },
        { "alias": "AAP",   "name": "Open Amount",          "description": "Current open (unpaid) amount",                      "dataType": "number", "example": "15000.00" },
        { "alias": "PAAP",  "name": "Original Amount",      "description": "Original domestic amount of the pay item",           "dataType": "number", "example": "15000.00" },
        { "alias": "GLPT",  "name": "GL Offset",            "description": "G/L posting code (offset account). KEY FIELD for R047001A — groups AP vouchers by their GL offset account", "dataType": "string", "example": "IN" },
        { "alias": "AID",   "name": "Account ID",           "description": "Account ID (links to F0901/F0902 for GL reconciliation)", "dataType": "string", "example": "00001.1110.ACME" },
        { "alias": "FY",    "name": "Fiscal Year",          "description": "Fiscal year (2-digit, e.g. 26=2026)",                "dataType": "number", "example": "26" },
        { "alias": "PN",    "name": "Period Number",        "description": "GL period number (1-14)",                            "dataType": "number", "example": "3" },
        { "alias": "DGJ",   "name": "GL Date",              "description": "General ledger date (Julian)",                       "dataType": "date",   "example": "2026-03-15" },
        { "alias": "DIV",   "name": "Invoice Date",         "description": "Supplier invoice date (Julian)",                     "dataType": "date",   "example": "2026-03-10" },
        { "alias": "DDJ",   "name": "Due Date",             "description": "Payment due date (Julian)",                          "dataType": "date",   "example": "2026-04-10" },
        { "alias": "PST",   "name": "Pay Status",           "description": "Payment status: A=Approved, D=Draft, H=Held, P=Paid, V=Void, X=Cancelled", "dataType": "string", "example": "A" },
        { "alias": "VINV",  "name": "Supplier Invoice",     "description": "Supplier invoice number",                            "dataType": "string", "example": "INV-2026-0042" }
      ]
    },
    {
      "tableName": "F0902",
      "displayName": "Account Balances",
      "description": "Account balance table. Stores net posting amounts by period for each account/ledger type/fiscal year. Used by R047001A to get the GL side of the integrity check.",
      "functionalArea": "General Ledger",
      "columns": [
        { "alias": "AID",   "name": "Account ID",           "description": "Account ID (structured: company.object.subsidiary)",  "dataType": "string", "example": "00001.1110.ACME" },
        { "alias": "CO",    "name": "Company",              "description": "Company code",                                       "dataType": "string", "example": "00001" },
        { "alias": "MCU",   "name": "Business Unit",        "description": "Business unit / cost center",                        "dataType": "string", "example": "1" },
        { "alias": "OBJ",   "name": "Object Account",       "description": "Object account (natural account, e.g. 1110=AP Trade)", "dataType": "string", "example": "1110" },
        { "alias": "SUB",   "name": "Subsidiary",           "description": "Subsidiary account (detail level)",                  "dataType": "string", "example": "ACME" },
        { "alias": "LT",    "name": "Ledger Type",          "description": "Ledger type: AA=Actual, AU=Units, CA=Budget",        "dataType": "string", "example": "AA" },
        { "alias": "FY",    "name": "Fiscal Year",          "description": "Fiscal year (2-digit)",                              "dataType": "number", "example": "26" },
        { "alias": "CTRY",  "name": "Century",              "description": "Century (19 or 20)",                                 "dataType": "number", "example": "20" },
        { "alias": "AN01",  "name": "Period 1 Amount",      "description": "Net posting amount for period 1",                    "dataType": "number", "example": "50000.00" },
        { "alias": "AN02",  "name": "Period 2 Amount",      "description": "Net posting amount for period 2",                    "dataType": "number", "example": "45000.00" },
        { "alias": "AN03",  "name": "Period 3 Amount",      "description": "Net posting amount for period 3",                    "dataType": "number", "example": "52000.00" },
        { "alias": "AN04",  "name": "Period 4 Amount",      "description": "Net posting amount for period 4",                    "dataType": "number", "example": "0" },
        { "alias": "AN05",  "name": "Period 5 Amount",      "description": "Net posting amount for period 5",                    "dataType": "number", "example": "0" },
        { "alias": "AN06",  "name": "Period 6 Amount",      "description": "Net posting amount for period 6",                    "dataType": "number", "example": "0" },
        { "alias": "AN07",  "name": "Period 7 Amount",      "description": "Net posting amount for period 7",                    "dataType": "number", "example": "0" },
        { "alias": "AN08",  "name": "Period 8 Amount",      "description": "Net posting amount for period 8",                    "dataType": "number", "example": "0" },
        { "alias": "AN09",  "name": "Period 9 Amount",      "description": "Net posting amount for period 9",                    "dataType": "number", "example": "0" },
        { "alias": "AN10",  "name": "Period 10 Amount",     "description": "Net posting amount for period 10",                   "dataType": "number", "example": "0" },
        { "alias": "AN11",  "name": "Period 11 Amount",     "description": "Net posting amount for period 11",                   "dataType": "number", "example": "0" },
        { "alias": "AN12",  "name": "Period 12 Amount",     "description": "Net posting amount for period 12",                   "dataType": "number", "example": "0" },
        { "alias": "AN13",  "name": "Period 13 Amount",     "description": "Net posting amount for period 13 (adjustments)",     "dataType": "number", "example": "0" },
        { "alias": "AN14",  "name": "Period 14 Amount",     "description": "Net posting amount for period 14 (adjustments)",     "dataType": "number", "example": "0" },
        { "alias": "BORG",  "name": "Beginning Balance",    "description": "Beginning balance for the fiscal year",              "dataType": "number", "example": "100000.00" }
      ]
    },
    {
      "tableName": "F0901",
      "displayName": "Account Ledger",
      "description": "Account ledger (journal entry detail). One row per GL transaction. Used for drill-down when R047001A discrepancies are found — shows the individual journal entries that make up the GL balance.",
      "functionalArea": "General Ledger",
      "columns": [
        { "alias": "AID",   "name": "Account ID",           "description": "Account ID (structured: company.object.subsidiary)",  "dataType": "string", "example": "00001.1110.ACME" },
        { "alias": "DOC",   "name": "Document Number",      "description": "Journal entry document number",                      "dataType": "number", "example": "12345" },
        { "alias": "DCT",   "name": "Document Type",        "description": "Document type (PV=Voucher, JE=Journal Entry, etc.)", "dataType": "string", "example": "PV" },
        { "alias": "KCO",   "name": "Document Company",     "description": "Company that owns the document",                     "dataType": "string", "example": "00001" },
        { "alias": "CO",    "name": "Company",              "description": "Company code",                                       "dataType": "string", "example": "00001" },
        { "alias": "MCU",   "name": "Business Unit",        "description": "Business unit / cost center",                        "dataType": "string", "example": "1" },
        { "alias": "LT",    "name": "Ledger Type",          "description": "Ledger type (AA=Actual)",                            "dataType": "string", "example": "AA" },
        { "alias": "FY",    "name": "Fiscal Year",          "description": "Fiscal year (2-digit)",                              "dataType": "number", "example": "26" },
        { "alias": "PN",    "name": "Period Number",        "description": "GL period number (1-14)",                            "dataType": "number", "example": "3" },
        { "alias": "AA",    "name": "Amount",               "description": "Transaction amount (positive=debit, negative=credit)", "dataType": "number", "example": "15000.00" },
        { "alias": "DGJ",   "name": "GL Date",              "description": "General ledger date (Julian)",                       "dataType": "date",   "example": "2026-03-15" },
        { "alias": "EXR",   "name": "Explanation",          "description": "Explanation / remark for the journal entry",         "dataType": "string", "example": "AP Voucher 12345" },
        { "alias": "AN8",   "name": "Address Number",       "description": "Address book number (supplier/customer)",             "dataType": "number", "example": "6001" },
        { "alias": "JELN",  "name": "Journal Entry Line",   "description": "Line number within the journal entry",               "dataType": "number", "example": "1" }
      ]
    },
    {
      "table": "F0011",
      "description": "Batch Control — stores batch header records for GL, AP, AR, and other subsystems. Used by R007011 (Unposted Batches Report) to identify batches that have not been posted.",
      "columns": [
        { "alias": "ICU",   "name": "Batch Number",         "description": "Batch number — unique identifier for the batch",     "dataType": "number", "example": "7842" },
        { "alias": "ICUT",  "name": "Batch Type",           "description": "Batch type code: G=General Ledger, V=Voucher, W=Time Entry, K=Receipts, I=Invoice, M=Manual Payment, O=Other", "dataType": "string", "example": "G" },
        { "alias": "KCO",   "name": "Document Company",     "description": "Company that owns the batch",                        "dataType": "string", "example": "00001" },
        { "alias": "ICUG",  "name": "Batch Status",         "description": "Batch status: blank=Pending, D=Approved, P=Posted, E=Error, A=In-Use", "dataType": "string", "example": "D" },
        { "alias": "ISTR",  "name": "Posted Code",          "description": "Posted code: blank=Unposted, D=Posted, P=Posted. Unposted batches have this field blank.", "dataType": "string", "example": "" },
        { "alias": "ICU1",  "name": "Batch Amount",         "description": "Total monetary amount of the batch",                 "dataType": "number", "example": "15000.00" },
        { "alias": "ECTC",  "name": "Transaction Count",    "description": "Number of transactions in the batch",                "dataType": "number", "example": "5" },
        { "alias": "DGL",   "name": "GL Date",              "description": "General ledger date for the batch (Julian)",          "dataType": "date",   "example": "2026-03-15" },
        { "alias": "USER",  "name": "User ID",              "description": "User who created the batch",                         "dataType": "string", "example": "JDEUSR" },
        { "alias": "PID",   "name": "Program ID",           "description": "Program that created the batch",                     "dataType": "string", "example": "P0911" },
        { "alias": "ICU5",  "name": "Batch Date",           "description": "Date the batch was created (Julian)",                 "dataType": "date",   "example": "2026-03-15" }
      ]
    },
    {
      "table": "F0911",
      "description": "Account Ledger (GL Transactions) — stores individual journal entry lines. Each row is one debit or credit line. Used with F0011 to drill into batch transaction details for R007011 analysis.",
      "columns": [
        { "alias": "ICU",   "name": "Batch Number",         "description": "Batch number — links to F0011.ICU",                  "dataType": "number", "example": "7842" },
        { "alias": "ICUT",  "name": "Batch Type",           "description": "Batch type code — links to F0011.ICUT",              "dataType": "string", "example": "G" },
        { "alias": "DOC",   "name": "Document Number",      "description": "Journal entry document number",                      "dataType": "number", "example": "12345" },
        { "alias": "DCT",   "name": "Document Type",        "description": "Document type (JE=Journal Entry, PV=Voucher, etc.)", "dataType": "string", "example": "JE" },
        { "alias": "KCO",   "name": "Document Company",     "description": "Company that owns the document",                     "dataType": "string", "example": "00001" },
        { "alias": "CO",    "name": "Company",              "description": "Company code",                                       "dataType": "string", "example": "00001" },
        { "alias": "AID",   "name": "Account ID",           "description": "Account ID (structured: company.object.subsidiary)",  "dataType": "string", "example": "00001.1110.ACME" },
        { "alias": "OBJ",   "name": "Object Account",       "description": "Object account (natural account)",                   "dataType": "string", "example": "1110" },
        { "alias": "SUB",   "name": "Subsidiary",           "description": "Subsidiary / sub-account",                           "dataType": "string", "example": "ACME" },
        { "alias": "AA",    "name": "Amount",               "description": "Transaction amount (positive=debit, negative=credit)", "dataType": "number", "example": "15000.00" },
        { "alias": "DGJ",   "name": "GL Date",              "description": "General ledger date (Julian)",                       "dataType": "date",   "example": "2026-03-15" },
        { "alias": "FY",    "name": "Fiscal Year",          "description": "Fiscal year (2-digit in JDE, e.g. 26 for 2026)",     "dataType": "number", "example": "26" },
        { "alias": "PN",    "name": "Period Number",        "description": "GL period number (1-14)",                            "dataType": "number", "example": "3" },
        { "alias": "EXR",   "name": "Explanation",          "description": "Explanation / remark for the journal entry line",     "dataType": "string", "example": "Monthly accrual" },
        { "alias": "AN8",   "name": "Address Number",       "description": "Address book number (supplier/customer)",             "dataType": "number", "example": "6001" },
        { "alias": "JELN",  "name": "Journal Entry Line",   "description": "Line number within the journal entry",               "dataType": "number", "example": "1" },
        { "alias": "LT",    "name": "Ledger Type",          "description": "Ledger type (AA=Actual, AU=Units, etc.)",             "dataType": "string", "example": "AA" }
      ]
    }
  ]
}
